# Copy to .env. Never commit the filled-in file.
# NEXT_PUBLIC_* values are public and embedded at build time.
NEXT_PUBLIC_DOMAIN=photos.example.com
NEXT_PUBLIC_LOCALE=zh-cn
NEXT_PUBLIC_NAV_TITLE=Photo Gallery

# Use a dedicated database reachable during build and runtime.
# URL-encode special characters in the database password.
POSTGRES_URL=postgresql://gallery:replace-me@db.example.com:5432/gallery?sslmode=require
# Set to 1 only for a trusted local database without TLS.
DISABLE_POSTGRES_SSL=0

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=https://photos.example.com
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@example.com
# Generate: node scripts/hash-password.mjs; select the matching output format.
ADMIN_PASSWORD_HASH=

# S3-compatible storage (including custom endpoints).
NEXT_PUBLIC_AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
# Hostname only, without https://. Optional with standard AWS S3.
NEXT_PUBLIC_AWS_S3_PUBLIC_DOMAIN=
NEXT_PUBLIC_AWS_S3_KEY_PREFIX=photos
NEXT_PUBLIC_DIRECT_STORAGE_IMAGES=1
